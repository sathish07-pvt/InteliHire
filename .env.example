# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-production-intellihire

# Database Configuration
# Supported options: "sqlite" or "mysql"
DB_TYPE=sqlite
# For MySQL:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=intellihire

# Or explicit SQLAlchemy URI:
# DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/intellihire
DATABASE_URL=sqlite:///intellihire.db

# File Uploads (in bytes, 5MB = 5242880)
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads/resumes

# Initial Administrator Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@intellihire.com
ADMIN_PASSWORD=Admin@12345
